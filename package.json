{
  "name": "algosnap",
  "displayName": "AlgoSnap",
  "description": "Smart algorithm templates with context-aware variable injection",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Snippets", "Programming Languages"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "algosnap.insertTemplate",
        "title": "AlgoSnap: Insert Algorithm Template"
      }
    ],
    "keybindings": [
      {
        "command": "algosnap.insertTemplate",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "AlgoSnap",
      "properties": {
        "algosnap.triggerOnType": {
          "type": "boolean",
          "default": true,
          "description": "Show template picker automatically when a keyword is typed"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
